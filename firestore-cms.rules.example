rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Merge this block into your EXISTING Firestore rules.
    // Do not replace unrelated project rules blindly.
    match /cms/site {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "GANTI_DENGAN_UID_ADMIN";
    }
  }
}
